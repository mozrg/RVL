+/* §startup-redesign-2: per user feedback, removed the big "RVL" watermark,
+   the rotating square "orbits" and the moving dot at the end of each orbit.
+   The loading screen now shows just the radial-vignette background + scanline
+   overlay + the centered brand mark + progress bar — nothing else. */
+.startup-screen::after { content: none !important; }
+.startup-grid { display: none !important; }
+.startup-orbit-one, .startup-orbit-two { display: none !important; }
 
 /* §content-stack — bring the brand text and progress bar above the
    scanline + watermark layers. */
 .startup-content {
     z-index: 2;
 }
+
+/* §hk-toggle: on/off + clear buttons in the preset detail panel.
+   They reuse .pd-btn's base styling but add a colored state —
+   green when the hotkey is on, muted when off. The clear button
+   shows an "×" glyph via its SVG icon (set in refreshRvlIcons).
+   Keep these compact so the pd-actions row doesn't widen the
+   whole hotkey row. */
+.pd-btn.pd-hk-toggle {
+    min-width: 30px;
+    height: 20px;
+    padding: 0 6px;
+    font-size: 8px;
+    font-weight: 700;
+    letter-spacing: 0.06em;
+    line-height: 18px;
+    border-radius: 0;
+}
+.pd-btn.pd-hk-toggle.pd-hk-on {
+    background: rgba(34, 197, 94, 0.12);
+    border-color: rgba(34, 197, 94, 0.5);
+    color: #22C55E;
+}
+.pd-btn.pd-hk-toggle.pd-hk-on:hover {
+    background: rgba(34, 197, 94, 0.18);
+    border-color: #22C55E;
+}
+.pd-btn.pd-hk-toggle.pd-hk-off {
+    background: #1A1A1A;
+    border-color: #333333;
+    color: #888888;
+}
+.pd-btn.pd-hk-toggle.pd-hk-off:hover {
+    background: #222222;
+    color: #BBBBBB;
+}
+body.theme-light .pd-btn.pd-hk-toggle.pd-hk-on {
+    background: rgba(34, 197, 94, 0.16);
+    border-color: rgba(34, 197, 94, 0.6);
+    color: #1E8E3D;
+}
+body.theme-light .pd-btn.pd-hk-toggle.pd-hk-off {
+    background: #FFFFFF;
+    border-color: #DADDE3;
+    color: #6A7280;
+}
+/* The clear-× button: matches other pd-btn 20×20 squares. */
+.pd-btn.pd-hk-clear {
+    color: #888888;
+}
+.pd-btn.pd-hk-clear:hover {
+    color: #FF7777;
+    border-color: #5A2A2A;
+    background: rgba(255, 80, 80, 0.06);
+}
