+/* ============================================================
+   §rvl-fixes — Square corners, hover unification, grid view,
+   guide footer, bulk method badges. Appended last so the
+   cascade wins over earlier duplicates of the same selectors.
+   ============================================================ */
+
+/* ── §square-corners — kill every rounded corner in the UI ── */
+/* User-requested: "убрать закругления, сделать квадратным".
+   The universal selector with !important beats every per-element
+   border-radius declared above. Inputs, buttons, cards, modal
+   corners, scrollbars, color swatches — all become square. */
+*,
+*::before,
+*::after {
+    border-radius: 0 !important;
+}
+
+/* ── §hover-unification — every clickable settings button gets
+   a visible hover state. Previously .theme-option (used by the
+   language/theme/scale/opacity/angle option rows) had no :hover
+   rule, so half the settings buttons reacted to hover and half
+   didn't, which read as broken. ── */
+.theme-option:hover {
+    background: #1A1A1A;
+    border-color: #555555;
+    color: #DDDDDD;
+}
+.theme-option.active:hover {
+    background: #FFFFFF;
+    border-color: #FFFFFF;
+    color: #000000;
+}
+body.theme-light .theme-option:hover {
+    background: #EEF0F3;
+    border-color: #B9BFCA;
+    color: #2A2F3A;
+}
+body.theme-light .theme-option.active:hover {
+    background: #17181C;
+    border-color: #17181C;
+    color: #FFFFFF;
+}
+/* .angle-option inherits from .theme-option but sits in a smaller
+   row — give it the same hover treatment. */
+.angle-options .theme-option:hover {
+    background: #1A1A1A;
+    border-color: #555555;
+    color: #DDDDDD;
+}
+
+/* ── §grid-view — denser, sharper grid cards.
+   Old grid: 56px tall cards, big gaps, soft borders. New grid:
+   tighter 64px cards, 1px hairline borders, accent-colored active
+   state, hover lift. The result reads as "grid of cards" instead
+   of "two fat rows of stretched preset rows". ── */
+.presets-list.grid-view {
+    padding: 4px 4px 6px;
+    column-gap: 6px;
+    row-gap: 6px;
+}
+.grid-view .preset-row {
+    width: calc(50% - 4px);
+    margin: 0 !important;
+    height: 64px !important;
+    min-height: 64px;
+    max-height: 64px;
+    padding: 8px 10px 8px 12px;
+    border: 1px solid #232323;
+    background: #0F0F0F;
+    box-sizing: border-box;
+    position: relative;
+    overflow: hidden;
+    display: inline-block !important;
+    vertical-align: top;
+    transition: border-color 0.18s, background 0.18s, box-shadow 0.18s, transform 0.18s;
+}
+.grid-view .preset-row:hover {
+    border-color: #3A3A3A;
+    background: #161616;
+    box-shadow: 0 2px 8px rgba(0,0,0,0.45);
+    transform: translateY(-1px);
+}
+.grid-view .preset-row-active {
+    border-color: #FFFFFF !important;
+    box-shadow: inset 3px 0 0 0 #FFFFFF, 0 2px 8px rgba(0,0,0,0.45) !important;
+    background: #1A1A1A !important;
+}
+/* Method-2 rows in grid view get a subtle indigo hairline so they
+   don't visually blend with Method-1 rows. */
+.grid-view .preset-row.preset-method-2 {
+    border-color: #2A2A4A;
+}
+.grid-view .preset-row.preset-method-2:hover {
+    border-color: #5A5A9A;
+}
+body.theme-light .grid-view .preset-row {
+    background: #FFFFFF;
+    border-color: #DADDE3;
+}
+body.theme-light .grid-view .preset-row:hover {
+    background: #F4F5F7;
+    border-color: #9099A8;
+}
+body.theme-light .grid-view .preset-row-active {
+    border-color: #17181C !important;
+    background: #E6E9EF !important;
+    box-shadow: inset 3px 0 0 0 #17181C, 0 2px 8px rgba(0,0,0,0.08) !important;
+}
+body.theme-light .grid-view .preset-row.preset-method-2 {
+    border-color: #B8B8E0;
+}
+
+/* ── §guide-footer-tip — fills the empty bottom area of the
+   760×380 guide window with a quick "which method when?" note. ── */
+.guide-footer-tip {
+    margin-top: 14px;
+    padding: 9px 11px;
+    background: #0C0C0C;
+    border: 1px solid #1E1E1E;
+    border-left: 2px solid #444444;
