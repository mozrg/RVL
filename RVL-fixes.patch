+    background: #1A2A1A;
+    border: 1px solid #2A4A2A;
+    color: #6BE36B;
+    font-size: 8px;
+    font-weight: 700;
+    letter-spacing: 0.04em;
+    flex-shrink: 0;
+    line-height: 1;
+    text-transform: uppercase;
+}
+.bulk-method-badge.bulk-method-m2 {
+    background: #1A1A2E;
+    border-color: #2E2E5A;
+    color: #8A8AE0;
+}
+body.theme-light .bulk-method-badge {
+    background: #EAF4EA; border-color: #B8D8B8; color: #2E7D32;
+}
+body.theme-light .bulk-method-badge.bulk-method-m2 {
+    background: #EAEAF6; border-color: #B8B8E0; color: #3A3A9E;
+}
+.bulk-row-m2 { background: rgba(120, 120, 220, 0.03); }
+.bulk-row-m2:hover { background: rgba(120, 120, 220, 0.07); }
+
+/* ── §startup-font — replace the loading-screen font.
+   User-requested: "Шрифт на загрузке надо изменить". The default
+   Segoe UI body font felt too thick for the orbit/grid "booting"
+   aesthetic. Switch to a monospace stack for the brand mark, kicker
+   and version line — they're short text fragments that benefit from
+   monospace's even rhythm. The status line stays sans for readability
+   of the localized "Загрузка интерфейса..." string. */
+.startup-screen,
+.startup-content {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+}
+.startup-mark {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+    font-weight: 700;
+    letter-spacing: 0.18em;
+    text-shadow: 0 0 18px rgba(232,232,232,0.22), 0 0 4px rgba(232,232,232,0.4);
+}
+.startup-kicker {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+    letter-spacing: 0.34em;
+    font-weight: 700;
+    color: #9A9A9A;
+}
+.startup-title {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+    font-weight: 600;
+    letter-spacing: 0.04em;
+}
+.startup-meta {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+    letter-spacing: 0.18em;
+}
+.startup-version {
+    font-family: 'Consolas', 'SF Mono', 'JetBrains Mono', 'Courier New', monospace;
+}
+/* Keep the status text in the regular sans font so localized messages
+   like "Загрузка интерфейса..." render naturally. */
+.startup-status {
+    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+}
